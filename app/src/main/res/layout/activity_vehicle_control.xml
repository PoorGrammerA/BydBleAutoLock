<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vehicle_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/vehicleAccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VEHICLE ACCESS"
            android:textColor="@color/vehicle_success"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/control_title"
            android:textColor="@color/vehicle_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/controlExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/control_description"
            android:textColor="@color/vehicle_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/vehicle_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/vehicle_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_vehicle_status"
                    android:textColor="@color/vehicle_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/vehicleInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/vehicle_text_primary"
                    android:textSize="16sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/vehicle_border" />

                <TextView
                    android:id="@+id/bleStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/vehicle_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/serviceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/vehicle_success"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/autoControlCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/vehicle_success"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/serviceToggleButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:backgroundTint="@color/vehicle_primary"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bluetoothPermissionBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/vehicle_surface_elevated"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/vehicle_warning"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/bluetoothPermissionMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vehicle_warning"
                    android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/requestBluetoothPermissionButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/allow_bluetooth_permission"
                    android:textAllCaps="false"
                    android:textColor="@color/vehicle_warning"
                    app:strokeColor="@color/vehicle_warning" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/batteryOptimizationBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/vehicle_surface_elevated"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/vehicle_warning"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/batteryOptimizationMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vehicle_warning"
                    android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/requestBatteryOptimizationButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/allow_battery_optimization_exclusion"
                    android:textAllCaps="false"
                    android:textColor="@color/vehicle_warning"
                    app:strokeColor="@color/vehicle_warning" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/automatic_control"
            android:textColor="@color/vehicle_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/vehicle_surface"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/vehicle_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/signal_strength_thresholds"
                    android:textColor="@color/vehicle_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/unlockThresholdLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/vehicle_text_secondary" />
                <SeekBar
                    android:id="@+id/unlockThresholdSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="59"
                    android:progressTint="@color/vehicle_primary"
                    android:thumbTint="@color/vehicle_primary" />
                <TextView
                    android:id="@+id/lockThresholdLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/vehicle_text_secondary" />
                <SeekBar
                    android:id="@+id/lockThresholdSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="59"
                    android:progressTint="@color/vehicle_primary"
                    android:thumbTint="@color/vehicle_primary" />
                <TextView
                    android:id="@+id/thresholdWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/vehicle_warning" />
                <TextView
                    android:id="@+id/autoControlCooldownLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/vehicle_text_secondary" />
                <SeekBar
                    android:id="@+id/autoControlCooldownSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="60"
                    android:progress="30"
                    android:progressTint="@color/vehicle_primary"
                    android:thumbTint="@color/vehicle_primary" />
                <CheckBox
                    android:id="@+id/pauseAutoControlWhileChargingCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:buttonTint="@color/vehicle_primary"
                    android:checked="true"
                    android:text="@string/pause_auto_control_while_charging"
                    android:textColor="@color/vehicle_text_primary"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/vehicle_surface"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/vehicle_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <CheckBox
                    android:id="@+id/autoClimateCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/vehicle_primary"
                    android:text="@string/start_climate_on_unlock"
                    android:textColor="@color/vehicle_text_primary"
                    android:textSize="16sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tempDownButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="−"
                        android:textColor="@color/vehicle_text_primary"
                        android:textSize="22sp"
                        app:strokeColor="@color/vehicle_border" />
                    <TextView
                        android:id="@+id/tempLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/vehicle_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tempUpButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:textColor="@color/vehicle_text_primary"
                        android:textSize="22sp"
                        app:strokeColor="@color/vehicle_border" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/manual_vehicle_control"
            android:textColor="@color/vehicle_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/manual_control_warning"
            android:textColor="@color/vehicle_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/unlockButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="Unlock doors" android:textAllCaps="false" android:textColor="@color/white" app:backgroundTint="@color/vehicle_primary" app:cornerRadius="14dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/lockButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Lock doors" android:textAllCaps="false" android:textColor="@color/vehicle_text_primary" app:cornerRadius="14dp" app:strokeColor="@color/vehicle_border" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/openTrunkButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="Open trunk" android:textAllCaps="false" android:textColor="@color/vehicle_warning" app:cornerRadius="14dp" app:strokeColor="@color/vehicle_warning" />
                <com.google.android.material.button.MaterialButton android:id="@+id/closeTrunkButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Close trunk" android:textAllCaps="false" android:textColor="@color/vehicle_text_primary" app:cornerRadius="14dp" app:strokeColor="@color/vehicle_border" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/openWindowsButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="Open windows" android:textAllCaps="false" android:textColor="@color/vehicle_text_primary" app:cornerRadius="14dp" app:strokeColor="@color/vehicle_border" />
                <com.google.android.material.button.MaterialButton android:id="@+id/closeWindowsButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Close windows" android:textAllCaps="false" android:textColor="@color/vehicle_text_primary" app:cornerRadius="14dp" app:strokeColor="@color/vehicle_border" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/startClimateButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="Start climate" android:textAllCaps="false" android:textColor="@color/vehicle_success" app:cornerRadius="14dp" app:strokeColor="@color/vehicle_success" />
                <com.google.android.material.button.MaterialButton android:id="@+id/stopClimateButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Stop climate" android:textAllCaps="false" android:textColor="@color/vehicle_text_primary" app:cornerRadius="14dp" app:strokeColor="@color/vehicle_border" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/flashButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="Flash lights" android:textAllCaps="false" android:textColor="@color/vehicle_text_primary" app:cornerRadius="14dp" app:strokeColor="@color/vehicle_border" />
                <com.google.android.material.button.MaterialButton android:id="@+id/findButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Flash + horn" android:textAllCaps="false" android:textColor="@color/vehicle_text_primary" app:cornerRadius="14dp" app:strokeColor="@color/vehicle_border" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/vehicle_surface"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/vehicle_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/control_activity_log"
                    android:textColor="@color/vehicle_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/control_activity_log_description"
                    android:textColor="@color/vehicle_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/controlLogView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/vehicle_text_secondary"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/devTestButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="@string/developer_test_screen"
            android:textAllCaps="false"
            android:textColor="@color/vehicle_text_secondary"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
